# CubeIDE этот файл не перезаписывает.
# GNU Tools 14.3 уже включает linked resources в Debug/makefile
# (Drivers/*, Middlewares/*, Application/User/gui|generated|TouchGFX, Core/Src).
# Не подключать subdir.mk / extra_linked_sources.mk повторно —
# иначе make: «overriding recipe for target …».

# GNU ld 14 предупреждает о LOAD-сегменте RWX на типичном STM32-скрипте
LIBS += -Wl,--no-warn-rwx-segments
